# ============================================================
# Один канонический адрес сайта: https://кинокрд.рф без www.
#
# Сертификат Let's Encrypt выписан на оба имени, поэтому и www,
# и апекс открываются без предупреждений — но индексироваться
# и показываться в адресной строке должен один адрес.
# ============================================================

# Главная страница собирается на сервере (секция наставников — из данных админки).
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # www → без www, сразу на https
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # http → https.
    # Проверяем и X-Forwarded-Proto: TLS терминирует nginx, и до Apache
    # запрос доходит уже по http — без этого условия получится петля.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Данные и журналы лежат выше public_html и по HTTP недоступны. Это подстраховка
# на случай, если их когда-нибудь положат рядом с сайтом.
#
# Через RedirectMatch, а не <FilesMatch>+Require: директива Require на этом
# сервере отдаёт 500 вместо отказа, а mod_alias отрабатывает штатно.
RedirectMatch 404 \.(jsonl|json|log)$

# lib/ — служебный код, который подключается из страниц. Открывать его
# напрямую незачем, а закрыть дешевле, чем гадать о последствиях.
RedirectMatch 404 ^/lib/
